# Documentation only; set these in the server process environment before startup.
# Never commit real values. Existing installations read DPAPI secrets when these are absent.
# APP_ENV=production
# PUBLIC_ORIGIN=https://learn.example.org
# TRUSTED_PROXY_IP=127.0.0.1
# DATA_ENCRYPTION_KEY=base64_encoded_32_byte_key_from_approved_secret_store
# Never replace the data key on an existing encrypted database without a tested rotation.
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_URL=jdbc:mysql://127.0.0.1:3306/ai_trainer_platform?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
